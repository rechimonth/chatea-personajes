{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/api/webhooks/stripe", "destination": "/api/webhooks?provider=stripe" },
    { "source": "/api/webhooks/mercadopago", "destination": "/api/webhooks?provider=mercadopago" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
