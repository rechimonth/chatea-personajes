# ============================================
# Google Gemini
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Vercel (autocompletar con vercel link)
# ============================================
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ============================================
# Aplicación
# ============================================
NODE_ENV=development
APP_URL=http://localhost:5173
APP_NAME=Chatea con tu personaje favorito

# ============================================
# Futuras expansiones
# ============================================
# Límite diario de mensajes por usuario
# MAX_DAILY_MESSAGES=50

# Analytics
# ANALYTICS_ID=UA-XXXXX-X

# Monitoreo
# SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Feature flags
# ENABLE_REGISTRATION=false
